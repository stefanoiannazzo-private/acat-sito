# ACAT Servizi - impostazioni per hosting Linux (Apache)

# 1) Forza https. Toglie il "#" dalle 3 righe sotto SOLO quando il certificato SSL è attivo
#    sul dominio, altrimenti il sito non si apre.
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) Compressione dei file di testo
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# 3) Cache del browser: immagini e font a lungo, pagine sempre fresche
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 4) Niente elenco dei file nelle cartelle
Options -Indexes
